# 后端配置：复制为 .env（同目录）后生效，.env 已被 .gitignore 忽略
# 用法：
#   copy .env.example .env          # 填好自己的值
#   npm start                       # 假 AI 插件（不联网，演示默认）
#   npm run start:ai                # 真实 DeepSeek + 知乎

# ── 服务 ──────────────────────────────────────────
# 监听端口，默认 4000
PORT=4000
# 监听地址，默认 127.0.0.1；需要局域网访问改成 0.0.0.0
HOST=127.0.0.1
# 下发给前端的 WebSocket 地址；默认由 host/port 推导，走公网或反代时再填
# PUBLIC_WS_ORIGIN=ws://127.0.0.1:4000

# ── 真实 AI（仅 npm run start:ai 需要）──────────────
# DeepSeek 的 API Key，只从环境变量读取，不会写盘或打印
DEEPSEEK_API_KEY=
# 可选的模型名，默认 deepseek-flash
# AI_MODEL=deepseek-flash

# ── 知乎数据源 ─────────────────────────────────────
# http    = 直连知乎开放平台（推荐，需要下面的 Access Secret）
# cli     = 调用本地 zhihu-cli（需要 ZHIHU_CLI_PATH）
# offline = 内置话题池（不联网，只影响话题来源，模型仍是真实的）
# 不填时自动选择：有 secret 用 http，其次 cli，最后 offline
ZHIHU_SOURCE=http

# 接口域名，默认 https://developer.zhihu.com
ZHIHU_API_BASE=https://developer.zhihu.com

# 知乎开放平台「个人中心」获取的 Access Secret，以 Bearer 方式调用
ZHIHU_ACCESS_SECRET=

# 回退方案：本地 zhihu-cli 可执行文件绝对路径（ZHIHU_SOURCE=cli 时生效）
ZHIHU_CLI_PATH=
